---
import { Font } from 'astro:assets';
import { getEntry } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative OG image. */
  image?: string;
  type?: 'website' | 'article';
}

const profile = (await getEntry('profile', 'me'))!.data;
const {
  title,
  description = profile.description,
  image = '/og.png',
  type = 'website',
} = Astro.props;
const fullTitle = title ? `${title} — ${profile.name}` : profile.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@denkivvakame" />
    <meta name="twitter:creator" content="@denkivvakame" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <Font cssVariable="--font-geist" preload={[{ weight: 400 }, { weight: 600 }]} />
    <Font cssVariable="--font-geist-mono" />
    <slot name="head" />
    <!--
      Publication row <-> detail page morph. Naming every row made each navigation capture
      dozens of elements, so only the row of the paper being opened (or returned from) gets a
      view-transition-name, and only for that transition. Inline in <head> so the pagereveal
      listener exists before the first render. Without JS (or the Navigation API) it is a fade.
    -->
    <script is:inline>
      (() => {
        const idOf = (url) => url && new URL(url).pathname.match(/^\/publications\/([^/]+)\/$/)?.[1];
        const name = (id, vt) => {
          const row = id && document.querySelector(`[data-pub="${CSS.escape(id)}"]`);
          if (!row || !vt) return;
          const title = row.querySelector('[data-pub-title]');
          row.style.viewTransitionName = `pub-${id}`;
          row.style.viewTransitionClass = 'pub';
          if (title) title.style.viewTransitionName = `pub-title-${id}`;
          // Clear afterwards, so a page restored from the back/forward cache starts clean.
          vt.finished.finally(() => {
            row.style.viewTransitionName = row.style.viewTransitionClass = '';
            if (title) title.style.viewTransitionName = '';
          });
        };
        // Leaving a list for /publications/<id>/: name the clicked row.
        addEventListener('pageswap', (e) => name(idOf(e.activation?.entry?.url), e.viewTransition));
        // Arriving at a list from /publications/<id>/: name that paper's row.
        addEventListener('pagereveal', (e) => name(idOf(window.navigation?.activation?.from?.url), e.viewTransition));
      })();
    </script>
  </head>
  <body>
    <slot />
    <footer class="site-footer">
      <div class="page inner mono">
        <span>© {new Date().getFullYear()} {profile.handle}</span>
        <span>{profile.footer}</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--color-border);
    background: var(--color-sunken);
  }
  .inner {
    padding-block: 22px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
</style>
