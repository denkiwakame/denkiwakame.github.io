---
interface Item {
  years: string;
  title: string;
  /** Secondary line (organization, subject, ...). */
  org?: string;
}

interface Props {
  label: string;
  items: Item[];
}
const { label, items } = Astro.props;
---

<div class="block">
  <div class="label">{label}</div>
  <ul>
    {
      items.map((item) => (
        <li>
          <span class="years mono">{item.years}</span>
          <div>
            <div class="title">{item.title}</div>
            {item.org && <div class="org">{item.org}</div>}
          </div>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .label {
    font-size: var(--text-meta);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  li {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 14px;
    align-items: baseline;
  }
  .years {
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  .title {
    font-size: var(--text-row);
    font-weight: 500;
    line-height: 1.4;
  }
  .org {
    font-size: var(--text-small);
    color: var(--color-muted);
    margin-top: 2px;
  }
</style>
