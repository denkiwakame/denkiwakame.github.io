---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chip from '../../components/Chip.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import Icon from '../../components/Icon.astro';
import ListRow from '../../components/ListRow.astro';
import PubRow from '../../components/PubRow.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getOrdered } from '../../lib/order';

export const getStaticPaths = (async () => {
  const projects = await getOrdered('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { title, description, pinned, art, teaser, tags, venues, links } = project.data;
const press = await Promise.all(
  project.data.press.map(async (ref) => {
    const item = await getEntry(ref);
    if (!item) throw new Error(`projects.yaml: "${project.id}" references unknown press item "${ref.id}"`);
    return item;
  }),
);
const papers = await Promise.all(
  project.data.papers.map(async (ref) => {
    const paper = await getEntry(ref);
    if (!paper) throw new Error(`projects.yaml: "${project.id}" references unknown paper "${ref.id}"`);
    return paper;
  }),
);
---

<Base title={title} description={description}>
  <main class="page detail">
    <a href="/#interests" class="back mono"><Icon name="back" size={12} />All interests</a>

    <div class="thumb" style={`view-transition-name: booth-${project.id}`}>
      {
        teaser ? (
          <Image src={teaser} alt="" widths={[640, 1280]} sizes="(min-width: 860px) 820px, 100vw" loading="eager" />
        ) : (
          <img src={`/art/${art}.svg`} alt="" width="320" height="200" />
        )
      }
      {
        pinned && (
          <span class="pin">
            <Icon name="pin" size={12} />
            PINNED
          </span>
        )
      }
    </div>

    <h1 style={`view-transition-name: booth-title-${project.id}`}>{title}</h1>
    <!-- Topic tags and venues on separate lines. -->
    {
      tags.length > 0 && (
        <div class="chips">
          {tags.map((t) => <Chip>{t}</Chip>)}
        </div>
      )
    }
    {
      venues.length > 0 && (
        <div class="chips">
          {venues.map((v) => <Chip variant="venue">{v}</Chip>)}
        </div>
      )
    }
    <p class="lede">{description}</p>
    {
      Object.keys(links).length > 0 && (
        <div class="links">
          {Object.entries(links).map(([label, href]) => (
            <ExternalLink href={href}>{label}</ExternalLink>
          ))}
        </div>
      )
    }

    {
      papers.length > 0 && (
        <section aria-labelledby="related">
          <SectionHeader id="related" title="Papers" icon="book" meta={`${papers.length} entries`} />
          <div class="pubs">
            {papers.map((p) => (
              <PubRow paper={p} />
            ))}
          </div>
        </section>
      )
    }

    {
      press.length > 0 && (
        <section aria-labelledby="press">
          <SectionHeader id="press" title="Press" icon="news" meta={`${press.length} ${press.length === 1 ? 'article' : 'articles'}`} />
          <div lang="ja">
            {press.map(({ data }) => (
              <ListRow href={data.link} title={data.title} aside={data.source} />
            ))}
          </div>
        </section>
      )
    }
  </main>
</Base>

<style>
  .detail {
    max-width: calc(820px + 2 * var(--gutter));
    padding-top: var(--space-header);
    padding-bottom: clamp(56px, 9vw, 88px);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  .thumb {
    position: relative;
    margin-top: 24px;
    aspect-ratio: 16 / 9;
    background: var(--color-thumb);
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-card);
    overflow: hidden;
  }
  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pin {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }
  h1 {
    margin: 28px 0 0;
    width: fit-content;
    font-size: clamp(24px, 1.2rem + 1.6vw, 32px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: var(--tracking-display);
    color: var(--color-fg-strong);
    text-wrap: balance;
  }
  .chips {
    margin-top: 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .chips + .chips {
    margin-top: 8px;
  }
  .lede {
    margin: 18px 0 0;
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--color-body);
    text-wrap: pretty;
  }
  .links {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  section {
    margin-top: var(--space-section);
  }
  .pubs {
    container-type: inline-size;
    border-top: 1px solid var(--color-border);
  }
</style>
