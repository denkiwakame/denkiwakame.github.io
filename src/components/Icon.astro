export type IconName = keyof typeof ICONS;

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 15 } = Astro.props;
const icon: { fill: boolean; width?: number; body: string } = ICONS[name];
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? undefined : 'currentColor'}
  stroke-width={icon.fill ? undefined : (icon.width ?? 1.8)}
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icon.body}
/>
