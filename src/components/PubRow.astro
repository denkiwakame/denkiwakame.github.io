---
import AuthorList from './AuthorList.astro';
import AwardBadge from './AwardBadge.astro';
import Chip from './Chip.astro';
import PosterModal from './PosterModal.astro';
import { resolveAuthors, type Paper } from '../lib/papers';

interface Props {
  paper: Paper;
}
const { paper } = Astro.props;
const { title, year, abbrev, venue, award, awardUrl, links } = paper.data;
// Only best paper awards are called out in the list; other awards stay on the detail page.
const bestAward = award && /best\s+paper/i.test(award) ? award : undefined;
const authors = await resolveAuthors(paper);
---

<!-- The row and title morph into the detail page header. Their view-transition-names are set
     only for the paper being opened or returned from (script in Base.astro): naming every row
     made each navigation capture dozens of elements. -->
<div class="row" data-pub={paper.id}>
  <span class="year mono">{year}</span>
  <div class="main">
    <!-- The morph target is this block, not the inline title: a wrapped inline box cannot take a view-transition-name. -->
    <div class="head" data-pub-title>
      <a class="title" href={`/publications/${paper.id}/`}>{title}</a>
      {bestAward && <span class="award"><AwardBadge award={bestAward} href={awardUrl} size="sm" /></span>}
    </div>
    <div class="authors"><AuthorList authors={authors} daggerNote={paper.data.daggerNote} daggerMark={paper.data.daggerMark} compact /></div>
  </div>
  <div class="side">
    <span title={venue}><Chip variant="accent">{abbrev}</Chip></span>
    <div class="links mono">
      {Object.entries(links).map(([label, href]) =>
        label === 'poster' ? <PosterModal href={href} id={paper.id} title={`Poster: ${title}`} /> : <a href={href} rel="noopener">{label}</a>,
      )}
    </div>
  </div>
</div>

<style>
  .row {
    display: grid;
    grid-template-columns: 56px 1fr 130px;
    grid-template-areas: 'year main side';
    gap: 18px;
    padding: 13px 0;
    border-bottom: 1px solid var(--color-rule);
    align-items: baseline;
  }
  /* Same hover as ListRow (Pet projects / Posts): white row, accent title. */
  .row:hover {
    background: var(--color-surface);
  }
  .row:hover .title {
    color: var(--color-accent);
  }
  .year {
    grid-area: year;
    font-size: var(--text-meta);
    color: var(--color-muted);
  }
  .main {
    grid-area: main;
  }
  .head {
    width: fit-content;
  }
  .title {
    display: inline;
    font-size: var(--text-row);
    line-height: 1.5;
    font-weight: 500;
    text-wrap: pretty;
  }
  .authors {
    font-size: 12px;
    color: var(--color-muted);
    margin-top: 3px;
    line-height: 1.5;
  }
  /* Badge sits right after the title text and wraps with it. */
  .award {
    display: inline-block;
    margin-left: 8px;
    vertical-align: 1px;
  }
  .side {
    grid-area: side;
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-items: flex-start;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    font-size: var(--text-micro);
  }
  .links a {
    color: var(--color-accent);
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Narrow: year + venue + links on one line, title block below.
     The parent list must set container-type: inline-size. */
  @container (width < 640px) {
    .row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        'year side'
        'main main';
      gap: 6px 12px;
    }
    .side {
      flex-direction: row;
      align-items: center;
      gap: 10px;
    }
  }
</style>
